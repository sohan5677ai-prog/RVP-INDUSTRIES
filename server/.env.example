# lib/prisma.ts appends connection_limit=5&pool_timeout=20 unless this URL
# already sets them - Prisma's default pool size is derived from the HOST's core
# count and will otherwise exhaust Supabase's pooler. Set either explicitly here
# to override.
DATABASE_URL="postgresql://rvp:rvp@localhost:5432/rvp?schema=public"
# Prisma migrations need a direct (non-pooled) connection. Locally this is the
# same URL as DATABASE_URL; on Supabase, DATABASE_URL is the pooled connection
# string (port 6543, ?pgbouncer=true) and DIRECT_URL is the direct one (port 5432).
DIRECT_URL="postgresql://rvp:rvp@localhost:5432/rvp?schema=public"
PORT=4000
# --- Weighbridge scale ---
# Set false on cloud servers receiving readings from the weighbridge terminal.
# Keep true only when the scale is physically connected to this server.
SCALE_LOCAL_ENABLED="true"
SCALE_COM_PORT="COM4"
SCALE_BAUD_RATE="2400"
# REQUIRED. The server refuses to start without this. Use a long random string
# (32+ chars), e.g. `openssl rand -hex 32`. Never commit the real value.
JWT_SECRET="change-me-in-production"
# Comma-separated list of allowed frontend origins (no trailing slash), e.g.
# "https://your-app.vercel.app,https://app.yourdomain.com"
CLIENT_ORIGIN="http://localhost:5173"
# Google Gemini API key for AI invoice reading on Stock In (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# --- File storage (Supabase Storage) ---
# Project URL and service_role key from Supabase Project Settings > API.
# The service_role key bypasses RLS - server-side only, never expose to the client.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket for uploaded invoice/kata files. Create it as a public bucket
# (files are already served as unguessable capability URLs, same as before).
SUPABASE_STORAGE_BUCKET="invoices"

# --- Slack bot (Socket Mode) ---
# Set SLACK_ENABLED=true to start the Slack bot alongside the API server.
SLACK_ENABLED="false"
# Bot User OAuth token (xoxb-...) - scopes: chat:write, commands, files:read,
# app_mentions:read, channels:history (or im:history).
SLACK_BOT_TOKEN=""
# App-Level token (xapp-...) with the connections:write scope, for Socket Mode.
SLACK_APP_TOKEN=""
# Signing secret (unused in Socket Mode; optional).
SLACK_SIGNING_SECRET=""

# --- Tally → ERP sync ---
# Shared secret the office-PC agent presents to POST /api/tally/sync. Set the SAME
# value here (server) and in the agent's environment. Use a long random string.
TALLY_SYNC_TOKEN=""
# --- Agent-only (set these on the office PC where the agent + Tally run) ---
# Public URL of the deployed ERP the agent pushes vouchers to.
ERP_BASE_URL="http://localhost:4000"
# Tally gateway location (agent runs on the same PC, so localhost).
TALLY_HOST="127.0.0.1"
TALLY_PORT="9000"
# Leave blank to use Tally's currently active company.
TALLY_COMPANY=""
# How far back each poll re-reads the day book (days). The server dedupes by GUID.
TALLY_LOOKBACK_DAYS="7"
# Poll interval in seconds.
TALLY_SYNC_INTERVAL_SEC="120"

# --- Email (Resend) ---
# Get your API key at https://resend.com
RESEND_API_KEY=""
# Verified sender, e.g. "RVP Industries <invoices@mail.yourdomain.com>". Until a
# domain is verified in Resend, leave blank to use the test sender
# onboarding@resend.dev (only delivers to the Resend account owner's own email).
RESEND_FROM_EMAIL=""

# =====================================================================
# Runtime
# =====================================================================
# "production" on Render. This is load-bearing for security, not just for
# logging: outside production the API returns error messages and stack traces
# in 500 responses and accepts localhost browser origins. Both are off when
# this is "production". See server/src/middleware/error.ts and lib/corsOrigin.ts.
NODE_ENV="development"
# winston level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL="info"
# Public URL of this API, used when building absolute links (e.g. kata slip
# URLs sent over WhatsApp). Falls back to the request host when unset.
PUBLIC_API_BASE_URL=""
# Public URL of the web client, used in outbound links.
APP_BASE_URL=""

# =====================================================================
# Kata cabin (the fixed weighbridge terminal)
# =====================================================================
# Username of the dedicated cabin account that must exist before activation.
KATA_CABIN_USERNAME="kata-cabin"
# Installation key the cabin browser presents once to get its scoped token.
# 24+ chars. Derived from JWT_SECRET when unset - set it explicitly to be able
# to rotate the cabin without rotating every session token.
KATA_CABIN_ACCESS_KEY=""

# =====================================================================
# CCTV bridge (scripts/cctv-bridge.mjs on the cabin PC)
# =====================================================================
# Shared secret the bridge presents as x-cctv-bridge-key when pushing frames
# and polling the print queue. 24+ chars. Derived from JWT_SECRET when unset;
# the server refuses camera-bridge calls if neither is configured.
CCTV_BRIDGE_KEY=""
# Camera credentials - only needed where the server itself pulls RTSP/HTTP
# frames. On the cloud server leave these blank; the cabin bridge pushes.
CCTV_CAM1_IP=""
CCTV_CAM1_PORT="80"
CCTV_CAM1_USER=""
CCTV_CAM1_PASS=""
CCTV_CAM2_IP=""
CCTV_CAM2_PORT="80"
CCTV_CAM2_USER=""
CCTV_CAM2_PASS=""
# Relay pacing: full rate while someone is watching, trickle when nobody is.
CCTV_ACTIVE_INTERVAL_MS=""
CCTV_IDLE_INTERVAL_MS=""
CCTV_VIEWER_TTL_MS=""

# =====================================================================
# Scheduled jobs
# =====================================================================
# Shared secret for the public POST /webhooks/whatsapp/jobs/:job endpoints,
# presented as X-Cron-Secret. Long random string - without it those endpoints
# reject every call.
CRON_SECRET=""
# In-process node-cron schedules (daily dues/dispatch, weekly summary).
WHATSAPP_CRON_ENABLED="false"

# =====================================================================
# WhatsApp (Fast2SMS, shared KNM business number)
# =====================================================================
WHATSAPP_ENABLED="false"
# Leave ON until the whole pipeline is verified: every send is redirected to
# WHATSAPP_TEST_NUMBER instead of the real recipient.
WHATSAPP_TEST_MODE="true"
WHATSAPP_TEST_NUMBER=""
FAST2SMS_API_KEY=""
FAST2SMS_PHONE_NUMBER_ID=""
# 40-char signing secret from the Fast2SMS dev panel. When set, the public
# /webhooks/whatsapp endpoint requires it back in the webhook_secret_key header.
FAST2SMS_WEBHOOK_SECRET=""
# Approved template ids (FAST2SMS_TMPL_*) and the standing recipient numbers
# are listed in render.yaml - copy the ones you need from there.
KNM_TRANSPORT_WHATSAPP_NUMBER=""
SUPPORT_WHATSAPP_NUMBER=""
SHABARI_WHATSAPP_NUMBER=""
WHATSAPP_DISPATCH_REMINDER_NUMBER=""

# =====================================================================
# Other integrations
# =====================================================================
# Svix signing secret for the public /webhooks/resend endpoint.
RESEND_WEBHOOK_SECRET=""
# Slack channel ids for kata alerts and dispatch notices.
SLACK_KATA_CHANNEL=""
SLACK_DISPATCH_CHANNEL=""
# Google Maps key for the location links in driver messages.
GOOGLE_MAPS_API_KEY=""
# Separate Supabase Storage bucket for financial-year archives (.rvparchive).
SUPABASE_ARCHIVE_BUCKET=""
# Razorpay - wired but dormant (subscription licensing gate).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
