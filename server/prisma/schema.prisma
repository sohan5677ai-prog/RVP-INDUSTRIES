enum StorageExpenseKind {
  ELECTRICITY
  SALARY
}

// Storage-facility running costs recorded on the Expenses → Storage Maintenance
// tab. Two kinds: ELECTRICITY (godown power bills) and SALARY (storage staff
// wages). Each entry posts a linked Payment to its own P&L expense head and is
// deducted from the husk recovery pool as an operating cost.
model StorageMaintenanceExpense {
  id        String             @id @default(cuid())
  date      DateTime
  kind      StorageExpenseKind
  label     String? // month (electricity) or employee / description (salary)
  amount    Decimal            @db.Decimal(12, 2)
  note      String?
  createdAt DateTime           @default(now())
}

// Resolves a Tally ledger name to an ERP Party. Built from the unmapped queue as
// the user confirms matches; consulted first by the importer before name-matching.
model TallyLedgerMap {
  id         String   @id @default(cuid())
  ledgerName String   @unique // exact Tally ledger name
  partyId    String?
  party      Party?   @relation(fields: [partyId], references: [id])
  note       String?
  createdAt  DateTime @default(now())
}

// Parking lot for Payment/Receipt vouchers whose counterparty ledger couldn't be
// matched to a Party. Surfaced in the UI for one-click manual mapping; never
// guessed onto the wrong party.
model TallyUnmappedVoucher {
  id            String   @id @default(cuid())
  tallyGuid     String   @unique
  voucherType   String // "Payment" | "Receipt"
  voucherNumber String?
  date          DateTime
  amount        Decimal  @db.Decimal(14, 2)
  ledgerName    String // the unmatched counterparty ledger
  narration     String?
  alterId       Int      @default(0)
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

enum WaDirection {
  OUTBOUND
  INBOUND
}

/// Language a party's WhatsApp messages go out in. Each value maps to a
/// separately-approved copy of the same template (same variable order), picked
/// at send time - see FAST2SMS_TMPL_<KEY>_<LANG> in whatsapp.service.ts.
enum WaLanguage {
  EN
  TE
  TA
  KN
  HI
}

enum WaStatus {
  SENT // handed to Fast2SMS successfully
  FAILED // send attempt errored
  SKIPPED // not sent (disabled / unconfigured / no phone) - recorded for visibility
  RECEIVED // inbound event captured by the webhook
}

// Audit trail of every WhatsApp message sent (or received) via Fast2SMS.
// Mirrors EmailLog: one row per attempt, success or failure, so the UI can
// show delivery state and offer a resend.
enum SupportTicketStatus {
  OPEN
  RESOLVED
}

/**
 * An in-app "Contact support" report: whoever hit the problem clicks the button
 * in the topbar, the app captures where they were and what the screen looked
 * like, and they add a sentence about what went wrong.
 * `userId` is a plain column, not a relation: a ticket is evidence about a
 * moment in time and must survive the reporter's user row being deleted, so the
 * name and role are denormalised alongside it rather than joined.
 */
model SupportTicket {
  id               String              @id @default(cuid())
  userId           String?
  userName         String
  userRole         String
  // Route the reporter was on, captured automatically: the raw path
  // ("/purchases/orders") plus the sidebar label shown for it ("Purchase Orders").
  pagePath         String
  pageLabel        String
  note             String
  // Public Supabase Storage URL of the captured screen. Null when the capture
  // failed or the browser blocked it - the ticket still goes out, text-only.
  screenshotUrl    String?
  // Free-form diagnostics gathered without asking the reporter: user agent,
  // viewport, and the last few console/network errors seen on the page.
  browserInfo      String?
  consoleErrors    String?
  status           SupportTicketStatus @default(OPEN)
  // Outcome of the WhatsApp alert, so a ticket that never reached a phone is
  // visibly distinct from one that did.
  notifiedStatus   String?
  notifiedError    String?
  createdAt        DateTime            @default(now())
  resolvedAt       DateTime?
  // What the developer wrote when closing the ticket - the reply everyone else
  // in the company is shown on their next login. Required to resolve, so a
  // RESOLVED ticket always has something to announce.
  developerMessage String?
  resolvedById     String?
  resolvedByName   String?
  acks             SupportTicketAck[]

  @@index([status, createdAt])
}

/**
 * "Yes, checked" - one row per person who has seen a resolved ticket's developer
 * message. Its absence is what keeps the login popup coming back, so "Let me
 * check" writes nothing at all and the reply resurfaces on the next refresh.
 * `userId` is a plain column for the same reason it is on the ticket: the
 * acknowledgement is a record of who read what, and outlives the user row.
 */
model SupportTicketAck {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  userName  String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([userId])
}

/**
 * Party Ledger "Schedule" option - a fully custom recurring WhatsApp payment
 * reminder for one party, independent of the manual "Payment Reminder" button.
 * One row per party (the Settings-style on/off + "Send Now" pattern didn't fit
 * here: each party needs its own time/day/frequency, not one shared toggle).
 * Fired by the sweep in whatsappJobs.ts (runPartyReminderSchedulesSweep, every
 * 10 min under WHATSAPP_CRON_ENABLED), which reuses the same
 * runPartyPaymentReminderCore the manual button calls - so a scheduled send
 * always quotes whatever is currently outstanding, never a stale invoice list
 * captured when the schedule was created.
 */
model PartyReminderSchedule {
  id      String @id @default(cuid())
  partyId String @unique
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  // Time of day, IST. hour 0-23, minute 0-59.
  hour   Int @default(10)
  minute Int @default(0)

  // DAILY | WEEKLY | INTERVAL
  frequency    String @default("DAILY")
  // WEEKLY only - 0=Sun..6=Sat.
  daysOfWeek   Int[]  @default([])
  // INTERVAL only - fire every N days, counted from lastSentAt (or from
  // creation, for the first send).
  intervalDays Int?

  // Who gets messaged when this fires - PARTY | BROKER | BOTH, same meaning as
  // the manual dialog's picker. Always the party's/brokers' FULL current dues
  // (no fixed invoice list), since the whole point is to keep chasing whatever
  // is outstanding at fire time.
  target String @default("PARTY")

  // When the schedule stops firing on its own:
  //  UNTIL_PAID   - disables itself the first time it finds nothing outstanding
  //  UNTIL_DATE   - disables itself once `endDate` (IST calendar day) has passed
  //  AFTER_COUNT  - disables itself once `sendsCount` reaches `maxSends`
  //  MANUAL       - never auto-stops; only a user can disable/delete it
  stopCondition String    @default("UNTIL_PAID")
  endDate       DateTime?
  maxSends      Int?

  sendsCount    Int       @default(0)
  lastSentAt    DateTime?
  // YYYY-MM-DD (IST) of the last fire, so DAILY/WEEKLY never double-send if the
  // sweep ticks more than once inside the same eligible window.
  lastSentKey   String?
  // Set when the schedule auto-disables itself - PAID | DATE_REACHED | COUNT_REACHED.
  stoppedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A manually-maintained directory of KNM lorry drivers, kept ONLY so the
/// Settings -> Wishes broadcast has a reliable recipient list - drivers are
/// otherwise just free-text name/phone fields on SaleDispatch/
/// TransportConfirmation rows and don't form a queryable directory anywhere
/// else in the app.
model KnmDriver {
  id        String        @id @default(cuid())
  name      String
  phone     String
  religion  WishCategory?
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

/// One row per Settings -> Wishes send: what was sent, to whom, and the
/// outcome tally. Purely a history/audit log - the actual per-recipient
/// delivery attempts still land in WhatsAppLog (relatedType 'WISH') the same
/// as every other broadcast in the app.
model WishBroadcast {
  id             String        @id @default(cuid())
  occasion       String
  // Null = "Everyone" (no religion filter).
  category       WishCategory?
  includeParties Boolean       @default(true)
  includeDrivers Boolean       @default(true)
  includeOwners  Boolean       @default(true)
  messageText    String
  imageUrl       String?
  recipientCount Int           @default(0)
  sentCount      Int           @default(0)
  failedCount    Int           @default(0)
  skippedCount   Int           @default(0)
  sentById       String?
  sentByName     String?
  createdAt      DateTime      @default(now())

  @@index([createdAt])
}

model WhatsAppLog {
  id           String      @id @default(cuid())
  direction    WaDirection @default(OUTBOUND)
  phone        String? // counterparty number (recipient for outbound, sender for inbound)
  template     String? // template key, e.g. 'PO_CREATED' (outbound only)
  language     WaLanguage? // which language copy was sent (outbound only)
  body         String? // rendered variable values (outbound) / raw text (inbound)
  mediaUrl     String?
  // Loose link back to the record that triggered the message, e.g.
  // ('PO', purchaseOrderId) or ('REMINDER', partyId). No FK - logs outlive edits.
  relatedType  String?
  relatedId    String?
  status       WaStatus
  errorMessage String?
  providerId   String? // Fast2SMS request/message id, when returned
  createdAt    DateTime    @default(now())

  @@index([relatedType, relatedId])
  @@index([createdAt])
}

// WAITING -> the lorry has been booked on WhatsApp but nothing has gone out on
// it yet. USED -> a dispatch was raised against that lorry number, which is what
// links the two. DISMISSED -> mis-parsed or irrelevant, hidden from the register.
// DRAFT/CONFIRMED are the pre-register states, kept only so old rows still read
// (DRAFT is shown as waiting, CONFIRMED as used).
enum TransportConfirmationStatus {
  DRAFT
  CONFIRMED
  DISMISSED
  WAITING
  USED
}

// A transport broker's lorry-confirmation message received on WhatsApp
// ("18/7 Punganur To Surat 30 Tonnes AP39T8217 Driver Moula 7207012803 ...")
// parsed into fields by Gemini.
//
// This is a REGISTER of booked lorries, not a correction tool: the row is filed
// WAITING and never touches an existing dispatch's freight. It earns its keep at
// dispatch time - typing the lorry number pulls the driver's name and phone off
// the waiting row, and raising the dispatch flips the row to USED.
model TransportConfirmation {
  id             String                      @id @default(cuid())
  fromPhone      String // WhatsApp sender
  rawText        String // original message, kept verbatim
  messageDate    DateTime? // date mentioned in the message
  fromPlace      String?
  toPlace        String?
  tonnageKg      Int?
  // Stored normalised (upper-case, no spaces or dashes) so a dispatch typed as
  // "AP 39 T 8217" still finds the row filed as "AP39T8217".
  lorryNumber    String?
  driverName     String?
  driverPhone    String?
  freightAmount  Decimal?                    @db.Decimal(12, 2)
  status         TransportConfirmationStatus @default(WAITING)
  saleDispatchId String? // dispatch this booking went out on
  createdAt      DateTime                    @default(now())

  @@index([status])
  @@index([lorryNumber])
  @@index([saleDispatchId])
}

// Persisted drafts for Slack multi-step flows (PO, Stock In, etc.)
model SlackDraft {
  id          String   @id @default(cuid())
  key         String   @unique // channel:threadTs or channel:slackUserId
  flow        String
  step        String?
  userId      String // ERP user ID
  role        String // ERP user role
  slackUserId String
  channel     String
  threadTs    String?
  data        String // JSON string of accumulated fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// SaaS licensing / monthly subscription gate. Singleton config row (there is
// only ever one, id = 1) that decides whether non-DEVELOPER users are locked
// out. The DEVELOPER role (the vendor) always bypasses. Amounts are stored in
// paise (INR * 100) to match Razorpay's smallest-currency-unit convention.
// ---------------------------------------------------------------------------
model Subscription {
  id              Int       @id @default(autoincrement())
  active          Boolean   @default(false) // master switch; false = gate OFF (safe default, never locks a fresh install)
  servicesStopped Boolean   @default(false) // developer kill switch: locks users & admins NOW, ignoring paidUntil
  monthlyAmount   Int       @default(0) // paise (INR * 100)
  billingDay      Int       @default(1) // day of month the fee is due (1-28)
  paidUntil       DateTime? // access granted through this instant
  lastPaymentId   String? // last razorpay payment id
  // Auto-recurring (Razorpay Subscriptions). Single-tenant, so at most one
  // active recurring mandate at a time; null when only the manual monthly
  // checkout is in use.
  razorpayPlanId  String? // reused across cycles while the amount is unchanged
  razorpaySubId   String? // the active recurring subscription id
  subStatus       String? // mirrors Razorpay: created|authenticated|active|halted|cancelled|completed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// One row per payment attempt - a manual one-time order OR a recurring charge.
// Lets us verify the payment server-side and keep an audit trail of what each
// payment bought.
model SubscriptionPayment {
  id                Int       @id @default(autoincrement())
  // Manual one-time flow has an order id; recurring charges have an invoice id
  // instead, so both are nullable+unique (Postgres allows many NULLs).
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?
  razorpaySubId     String? // set for recurring charges
  invoiceId         String?   @unique // recurring charge id - the webhook idempotency key
  source            String    @default("manual") // manual | recurring
  amount            Int // paise
  status            String    @default("created") // created | paid | failed
  periodEnd         DateTime? // paidUntil this payment bought
  createdAt         DateTime  @default(now())
}
