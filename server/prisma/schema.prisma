generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
  OWNER
  DEVELOPER
}

enum PartyType {
  SUPPLIER
  BUYER
  BOTH
  HAMALI_TEAM
}

enum BalanceType {
  DR
  CR
}


/// Religious community tag used ONLY to target the Settings → Wishes broadcast
/// (festival/occasion messages) at the right audience - nowhere else in the
/// app reads this. Unset (null) means "not tagged yet": such a party/driver is
/// still included in an "Everyone" wish but excluded from any
/// religion-filtered one, so an untagged record never gets miscategorised.
enum WishCategory {
  HINDU
  MUSLIM
  CHRISTIAN
  OTHER
}

enum POStatus {
  PENDING
  ARRIVED
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  PENDING
  PARTIAL
  DISPATCHED
  DELIVERED
}

enum AllocationStatus {
  SOFT
  HARD
  BUMPED
}

// Products sold. Pappu depletes the black-seed pool; Husk depletes its derived
// (25%) availability; TPS (brokens) is revenue-only. Shell, Waste and the three
// pre-cleaner byproducts (Pre Cleaner Dust, Nalla Pokkulu, Nalla Chintapandu)
// all deplete the single shared 10% "Pre Cleaner Husk & Tamarind" pool. Shell is
// physically transferred to another location before sale, but that transfer is
// only a movement/cost record - it is NOT held as a separate valued silo.
enum SaleProduct {
  PAPPU
  HUSK
  WASTE
  TPS
  SHELL
  PRECLEANER_DUST
  NALLA_POKKULU
  NALLA_CHINTAPANDU
}

enum Commodity {
  BLACK_SEED
  PAPPU
  HUSK
  TAMARIND_SHELL
  TAMARIND_WASTE
  TPS_BROKENS
  PRECLEANER_DUST
  NALLA_POKKULU
  NALLA_CHINTAPANDU
}

model User {
  id          String   @id @default(cuid())
  name        String
  username    String   @unique
  password    String
  role        Role     @default(USER)
  // Slack member ID (e.g. "U0123ABCD") used to attribute Slack-driven actions to
  // this ERP user. Null until an admin links the account.
  slackUserId String?  @unique
  createdAt   DateTime @default(now())

  sessions UserSession[]
}

/// One row per device a user is signed in on. The login flow caps a normal
/// account at MAX_DEVICES_PER_USER live rows; rows go stale (and stop counting)
/// once lastSeenAt falls outside the idle window, so a lost or closed device
/// frees its slot on its own. See server/src/lib/sessionPolicy.ts.
model UserSession {
  id         String   @id @default(cuid())
  userId     String
  /// Random id the browser mints once and keeps in localStorage.
  deviceId   String
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, lastSeenAt])
}

model Party {
  id                  String                 @id @default(cuid())
  name                String
  // Short handle used as the PO-number series key, e.g. "DCS" -> DCS/01/26-27.
  nickname            String?
  type                PartyType              @default(SUPPLIER)
  phone               String?
  phone2              String?
  email               String?
  address             String?
  // Town/city of the party's premises. The e-invoice (`Loc`) and the E-Way Bill
  // ("Ship To" place) want the CITY, not the state - "Surat", not "Gujarat".
  city                String?
  state               String?
  pincode             String?
  gstin               String?
  // Default delivery destination for this buyer (maps to a freight rate).
  destination         String?
  // Google Maps link to the party's delivery point - sent to the lorry driver
  // on dispatch via WhatsApp.
  locationLink        String?
  // Whether this buyer's shipments travel on a Surya Road Lines lorry receipt
  // (GC note). Most do not, so the receipt is offered on a dispatch only when
  // this is switched on for the buyer. Off for everyone until set.
  lorryReceiptEnabled Boolean                @default(false)
  // Language this party's WhatsApp messages go out in. EN until someone sets it
  // on the party form; an unapproved language falls back to the English copy at
  // send time, so switching this can never stop a message going out.
  waLanguage          WaLanguage             @default(EN)
  // Settings -> Wishes targeting only (see WishCategory). Null = not tagged.
  religion            WishCategory?
  // Opening balance brought forward (unpaid legacy balance).
  openingBalance      Decimal                @default(0) @db.Decimal(14, 2)
  openingBalanceType  BalanceType            @default(CR)
  bankAccountNumber   String?
  bankIfsc            String?
  bankName            String?
  commodities         Commodity[]
  createdAt           DateTime               @default(now())
  purchaseOrders      PurchaseOrder[]
  saleOrders          SaleOrder[]
  payments            Payment[]
  receipts            Receipt[]
  dustPurchases       DustPurchase[]
  tallyLedgerMaps     TallyLedgerMap[]
  creditNotes         CreditNote[]
  debitNotes          DebitNote[]
  emailLogs           EmailLog[]
  setOffs             PartySetOff[]
  reminderSchedule    PartyReminderSchedule?
  addresses           PartyAddress[]
}

model PartyAddress {
  id          String   @id @default(cuid())
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId     String
  label       String   // e.g. "Head Office", "Surat Warehouse", "Factory Unit 2"
  address     String
  city        String?
  state       String?
  pincode     String?
  gstin       String?  // Optional branch-specific GSTIN
  destination  String?  // Optional address-specific freight delivery destination
  phone        String?  // Optional branch phone 1
  phone2       String?  // Optional branch phone 2
  locationLink String?  // Optional Google Maps / location link for this address
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([partyId])
}

model Broker {
  id              String      @id @default(cuid())
  name            String
  phone           String?
  waLanguage      WaLanguage  @default(EN)
  // Flat brokerage credited per dispatched sale order under this broker -
  // configurable per broker (was a single hardcoded ₹2,000 for everyone).
  brokerageAmount Decimal     @default(2000) @db.Decimal(12, 2)
  saleOrders      SaleOrder[]
  payments        Payment[]
}

model PurchaseOrder {
  id               String           @id @default(cuid())
  poNumber         String?          @unique
  poDate           DateTime
  party            Party            @relation(fields: [partyId], references: [id])
  partyId          String
  pricePerKg       Decimal          @db.Decimal(12, 2) // approx
  // Whether pricePerKg is quoted at the supplier's location (BASE) or landed at
  // our location (DELIVERY). Some suppliers quote one, some the other.
  priceType        PriceType        @default(DELIVERY)
  // Coarse intended destination for this PO's stock, set when the order is placed.
  // STOCK-bound POs are held OUT of the Order Planner's pending pool (not sellable)
  // until their lorry is actually stocked in - the real landing spot is chosen at
  // stock-in (loadingLocation). A STOCK-planned lorry stocked into RVP at arrival
  // still flows into the planner, because the arrived band keys off the real
  // stock-in location, not this flag. Defaults to RVP so existing POs are unaffected.
  plannedLocation  PlannedLocation  @default(RVP)
  hasGst           Boolean          @default(false)
  gstAmount        Decimal          @default(0) @db.Decimal(14, 2)
  tonnageKg        Int // approx, in kg
  actualTonnageKg  Int? // actual arrived weight in kg (set at stock-in)
  lorryCount       Int? // approx number of lorries ordered
  // Links all per-lorry POs created together from one order, so they can be
  // grouped back into a single logical order in the UI.
  poGroupId        String?
  status           POStatus         @default(PENDING)
  expectedYieldPct Decimal          @default(60) @db.Decimal(5, 2)
  createdBy        String
  createdAt        DateTime         @default(now())
  stockIns         StockIn[]
  allocations      SaleAllocation[]
  // PO-number components: poNumber = "{poSeriesKey}/{poSerial}/{poFy}" per lorry.
  // A poGroupId batch's collapsed display range is derived from min/max poSerial
  // across its members. Null on legacy/KNM_BATCH rows that predate this scheme.
  poSeriesKey      String?
  poSerial         Int?
  poFy             String?

  // Party ledger + planner group/filter POs by supplier; index the FK so those
  // GROUP BY / WHERE partyId scans stay index-driven as the table grows.
  @@index([partyId])
}

// Running per-series-per-financial-year counter backing PO numbering
// (e.g. seriesKey "DCS", fy "26-27" -> lastSerial 6). Incremented atomically
// when a batch of lorries is created so numbers never collide or reuse.
model PoSerialCounter {
  id         String @id @default(cuid())
  seriesKey  String
  fy         String
  lastSerial Int    @default(0)

  @@unique([seriesKey, fy])
}

// Per-FY sequential counter for credit/debit note numbering, keyed by note
// type ('CN' | 'DN'). Mirrors PoSerialCounter's atomic-increment shape.
model NoteSerialCounter {
  id         String @id @default(cuid())
  seriesKey  String
  fy         String
  lastSerial Int    @default(0)

  @@unique([seriesKey, fy])
}

enum NoteStatus {
  ISSUED
  CANCELLED
}

model CreditNote {
  id             String        @id @default(cuid())
  noteNumber     String        @unique // e.g. RVP/CN/01/26-27
  noteSeq        Int
  noteFy         String
  noteDate       DateTime      @default(now())
  party          Party         @relation(fields: [partyId], references: [id])
  partyId        String
  // Optional - a note might be raised without tying to one specific shipment.
  saleDispatch   SaleDispatch? @relation(fields: [saleDispatchId], references: [id])
  saleDispatchId String?
  reason         String
  // GST-aware breakdown, since this adjusts an invoice already reported with GST.
  taxableValue   Decimal       @db.Decimal(14, 2)
  gstRate        Decimal       @db.Decimal(5, 2)
  gstAmount      Decimal       @db.Decimal(14, 2)
  totalAmount    Decimal       @db.Decimal(14, 2)
  status         NoteStatus    @default(ISSUED)
  createdAt      DateTime      @default(now())

  emailLogs EmailLog[]

  @@unique([noteFy, noteSeq])
  @@index([partyId])
  @@index([saleDispatchId])
}

model DebitNote {
  id             String        @id @default(cuid())
  noteNumber     String        @unique // e.g. RVP/DN/01/26-27
  noteSeq        Int
  noteFy         String
  noteDate       DateTime      @default(now())
  party          Party         @relation(fields: [partyId], references: [id])
  partyId        String
  saleDispatch   SaleDispatch? @relation(fields: [saleDispatchId], references: [id])
  saleDispatchId String?
  reason         String
  taxableValue   Decimal       @db.Decimal(14, 2)
  gstRate        Decimal       @db.Decimal(5, 2)
  gstAmount      Decimal       @db.Decimal(14, 2)
  totalAmount    Decimal       @db.Decimal(14, 2)
  status         NoteStatus    @default(ISSUED)
  createdAt      DateTime      @default(now())

  emailLogs EmailLog[]

  @@unique([noteFy, noteSeq])
  @@index([partyId])
  @@index([saleDispatchId])
}

enum EmailDocumentType {
  INVOICE
  EWB
  CREDIT_NOTE
  DEBIT_NOTE
}

enum EmailStatus {
  SENT
  FAILED
}

// Audit trail of every document email sent to a party. Only one of
// saleDispatchId/creditNoteId/debitNoteId is set per row, matching documentType.
model EmailLog {
  id              String            @id @default(cuid())
  party           Party             @relation(fields: [partyId], references: [id])
  partyId         String
  documentType    EmailDocumentType
  saleDispatch    SaleDispatch?     @relation(fields: [saleDispatchId], references: [id])
  saleDispatchId  String?
  creditNote      CreditNote?       @relation(fields: [creditNoteId], references: [id])
  creditNoteId    String?
  debitNote       DebitNote?        @relation(fields: [debitNoteId], references: [id])
  debitNoteId     String?
  referenceLabel  String // denormalized e.g. "RVP/01/26-27" for display without joins
  recipientEmail  String
  subject         String
  resendMessageId String?
  status          EmailStatus
  errorMessage    String?
  sentAt          DateTime          @default(now())

  @@index([partyId])
  @@index([saleDispatchId])
}

model StockIn {
  id                String        @id @default(cuid())
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId   String
  arrivalDate       DateTime
  lorryNumber       String
  invoiceNumber     String // invoice number (e.g. "69")
  rvpFirstWeightKg  Int           @default(0) // RVP weighbridge: loaded/gross weight
  rvpSecondWeightKg Int           @default(0) // RVP weighbridge: empty/tare weight
  rvpKataKg         Int // Net weight from our weighbridge (RVP Kata) = first - second
  // Direct net entry (spot/URP): the operator typed the RVP net straight in with no
  // separate tare weighment, so rvpFirstWeightKg holds the net and rvpKataKg = it.
  // Persisted so edits keep the net as-is instead of recomputing first − second (→ 0).
  directNet         Boolean       @default(false)
  billingWeightKg   Int // invoice tonnage
  // Rate (Rs/kg) the party actually printed on their GST invoice, when it differs
  // from the PO price. Some suppliers quote us a DELIVERY (landed) price but bill
  // at their BASE price, so the taxable value - and therefore the input GST we can
  // claim - is lower than billingWeightKg x PO price. Null = billed at the PO price.
  // It moves the TAX BASE ONLY: the payable and the seed's landed cost stay on the
  // PO price, because we still pay the party the full delivery rate.
  billingRatePerKg  Decimal?      @db.Decimal(12, 2)
  partyKataKg       Int // party weighbridge
  invoiceFileUrl    String // uploaded invoice
  loadingLocation   String        @default("RVP")
  // Inward freight (₹) captured at arrival, only for BASE-priced POs (DELIVERY
  // already includes it). Carried into Purchase.freightCharge and capitalised.
  freightCharge     Decimal       @default(0) @db.Decimal(12, 2)
  // Whole-vehicle tonnage (kg) the inward freight is spread over. Set when the lorry
  // is SHARED between parties: freight/kg = freightCharge / freightTonnageKg, and this
  // party's landed price = base + that rate. Null → single-party lorry, so the basis
  // falls back to this arrival's net weight (freight/kg = freightCharge / netWeightKg).
  freightTonnageKg  Int?
  // Ticked when the party arrived in their OWN vehicle (no third-party lorry).
  // At verification the lorry's ₹80/t hamali share - normally recovered from the
  // transporter - is instead deducted from the party's net payable.
  selfVehicle       Boolean       @default(false)
  createdAt         DateTime      @default(now())
  purchase          Purchase?

  @@index([purchaseOrderId])
}

model Purchase {
  id           String       @id @default(cuid())
  stockIn      StockIn      @relation(fields: [stockInId], references: [id])
  stockInId    String       @unique
  netWeightKg  Int // StockIn.rvpKataKg
  hamaliRate   Decimal      @default(80) @db.Decimal(8, 2) // per tonne
  hamaliCharge Decimal      @db.Decimal(12, 2) // computed
  kataFee      Decimal      @default(0) @db.Decimal(12, 2) // computed
  // Bag-cutting (pouring black seed into a process bunker). Only set when the
  // stock lands directly at the process; storage stock gets it on transfer.
  bunkerPlace  BunkerPlace?

  // Inward freight to bring BASE-priced stock to our location (capitalised into
  // the seed). DELIVERY-priced POs already include freight in the price → 0.
  freightCharge    Decimal             @default(0) @db.Decimal(12, 2)
  // Whole-vehicle tonnage (kg) the freight is spread over, for SHARED lorries.
  // Null → single-party lorry, basis falls back to netWeightKg. See StockIn.freightTonnageKg.
  freightTonnageKg Int?
  discountType     DiscountType?
  discountValue    Decimal             @default(0) @db.Decimal(12, 2)
  // Operator-settable purchase date (the effective date of the purchase, shown on
  // the Stock-in Detail and Verification pages). Defaults to when the record was
  // created; existing rows fall back to createdAt in the app.
  purchaseDate     DateTime            @default(now())
  createdAt        DateTime            @default(now())
  verification     WeightVerification?
  payments         Payment[]
  processing       Processing?
}

model WeightVerification {
  id                 String   @id @default(cuid())
  purchase           Purchase @relation(fields: [purchaseId], references: [id])
  purchaseId         String   @unique
  billingWeightKg    Int
  partyKataKg        Int
  rvpKataKg          Int
  referenceKg        Int
  diffKg             Int
  exempt             Boolean
  finalWeightKg      Int
  pricePerKg         Decimal  @db.Decimal(12, 2)
  // Snapshot of StockIn.billingRatePerKg at verification time - the settlement
  // record has to carry its own tax basis so the statement PDF, the ledger and the
  // GST report can never drift from what was actually settled. Null = PO price.
  billingRatePerKg   Decimal? @db.Decimal(12, 2)
  // Net balance payable to the supplier (already net of any self-vehicle hamali
  // and kata recovery below). Seed inventory value = totalAmount + selfVehicleHamali.
  totalAmount        Decimal  @db.Decimal(14, 2)
  // ₹ deducted from the party's payable because they used their own vehicle
  // (the lorry's ₹80/t hamali share). 0 for third-party lorries.
  selfVehicleHamali  Decimal  @default(0) @db.Decimal(12, 2)
  // ₹ deducted from the party's payable because they used their own vehicle
  // (the full weighbridge/kata fee, normally recovered from the transporter).
  // Recovering it lowers the seed's landed cost. 0 for third-party lorries.
  selfVehicleKata    Decimal  @default(0) @db.Decimal(12, 2)
  // Extra billed-on costs the user itemises at approval (loading, brokerage,
  // misc). Stored as [{ label, amount }]. Each ADDS to the supplier's net
  // payable AND capitalises into the seed's landed cost, so the ledger and the
  // silo MAP stay balanced (both derive from totalAmount, which already
  // includes the addables total).
  billAddables       Json?
  // Deductions the user itemises at approval - the mirror of billAddables.
  // Stored as [{ mode, label, value, amount }] where mode is WEIGHT | PRICE |
  // AMOUNT | EXPENSE | FREIGHT, `value` is what was typed (kg / ₹ per kg / ₹)
  // and `amount` is the resulting ₹ off the payable. Any mode may repeat.
  // FREIGHT rows also become a lorry due on the Freight Dues page - see
  // computeQualityAdjustments in lib/calc.ts. Null on pre-feature rows, which
  // fall back to Purchase.discountType/discountValue.
  qualityAdjustments Json?
  createdAt          DateTime @default(now())

  @@index([purchaseId])
}

model Processing {
  id                  String    @id @default(cuid())
  // Optional link back to the verified Purchase this batch was milled from.
  // Nullable so standalone (manually-entered) processing runs remain valid.
  purchase            Purchase? @relation(fields: [purchaseId], references: [id])
  purchaseId          String?   @unique
  blackWeightKg       Int // input weight processed in mill
  outTurnPct          Decimal   @default(60) @db.Decimal(5, 2)
  pappuWeightKg       Int // computed
  huskWeightKg        Int       @default(0) // 25% yield
  wasteWeightKg       Int       @default(0) // 10% yield
  lostWeightKg        Int       @default(0) // 5% negligible waste
  overheadElectricity Decimal   @default(0) @db.Decimal(12, 2)
  overheadWages       Decimal   @default(0) @db.Decimal(12, 2)
  overheadMaintenance Decimal   @default(0) @db.Decimal(12, 2)
  loadingLocation     String    @default("RVP")
  processDate         DateTime
}

model SaleOrder {
  id                 String      @id @default(cuid())
  saleDate           DateTime
  product            SaleProduct @default(PAPPU)
  buyer              Party       @relation(fields: [buyerId], references: [id])
  buyerId            String
  broker             Broker?     @relation(fields: [brokerId], references: [id])
  brokerId           String?
  tonnageKg          Int // total weight ORDERED, per RVP kata (kg) - never overwritten
  ratePerKg          Decimal     @db.Decimal(12, 2)
  gstAmount          Decimal     @default(0) @db.Decimal(14, 2) // 5% IGST on weight × rate (0 when gstExempt)
  // When true, this order (and its dispatches) is billed WITHOUT GST - set per
  // order in the dialog for parties billed on a non-GST basis.
  gstExempt          Boolean     @default(false)
  brokerageRatePerKg Decimal     @default(0) @db.Decimal(12, 2)
  // Delivery destination (Surat/Barshi/Nagar) and the outward freight we bear,
  // since pappu etc. is sold at a delivery price. Freight is our selling expense.
  destination        String?
  freightCharge      Decimal     @default(0) @db.Decimal(12, 2)
  // Whether ratePerKg is quoted ex-works at our gate (BASE - the buyer lifts the
  // goods on their own lorry) or landed at their place (DELIVERY - the quoted
  // rate includes freight and we bear it). Pappu is always DELIVERY; husk and the
  // other byproducts are usually BASE but are occasionally sold delivered. BASE
  // forces freightCharge to 0 even when the buyer's party has a destination on
  // file - see deriveDestinationFreight. Defaults to DELIVERY so every order
  // booked before this column existed keeps exactly the freight it was booked
  // with.
  priceType          PriceType   @default(DELIVERY)
  // PENDING (nothing dispatched) → PARTIAL (some, remaining > 0) → DISPATCHED
  // (fully dispatched). The order itself is never DELIVERED; delivery is tracked
  // per dispatch (shipment).
  status             SaleStatus  @default(PENDING)
  marginOverride     Boolean     @default(false)
  // Payment terms: number of credit days. The clock starts from each dispatch's
  // deliveredDate, so dueDate = dispatch.deliveredDate + dueDays.
  dueDays            Int?
  // Optional dispatch reminder for advance orders: the date the goods are due to
  // be dispatched. The ERP surfaces a login reminder from 3 days before this date.
  reminderDate       DateTime?

  // Customer PO (Purchase Order) reference
  poNumber           String?
  poDate             DateTime?

  // Delivery / Billing address selected at order creation (snapshotted so historical
  // orders and invoices remain immutable even if the party updates their address book).
  buyerAddressId     String?
  buyerAddress       String?
  buyerCity          String?
  buyerState         String?
  buyerPincode       String?
  buyerGstin         String?

  // --- Cost freeze -----------------------------------------------------------
  // The Pappu P&L used to recompute every order from scratch on each page load,
  // so a Settings edit, a late stock-in, a PO verification or a loan re-rate all
  // silently rewrote history. These columns pin an order's costs to what was
  // true when it was taken / shipped.
  //
  // Stamped at CREATION, so changing a destination's rate in Settings applies
  // only to orders taken after the change (Surat 2800 -> 3000 leaves every
  // earlier order at 2800). Null on legacy rows = fall back to the live rate.
  // NB: rated PER TONNE (calcSaleFreight takes tonnes), not per kg.
  freightRatePerTonne Decimal?  @db.Decimal(12, 4)
  // Written once the order is FULLY dispatched: the price bands (and seed kg)
  // that actually backed it. From then on the margin reads this instead of
  // re-running the allocator, so nothing bought or repriced later can move it.
  // Cleared by undo-dispatch, which re-opens the order.
  seedCostSnapshot    Json?
  costFrozenAt        DateTime?

  // --- Short close -----------------------------------------------------------
  // tonnageKg is what was BOOKED; the lorry's kata weight is what actually went.
  // A 25 t husk order that ships 24.87 t is finished, but plain arithmetic leaves
  // 130 kg "remaining" on it forever (worst on the loose byproducts, where no
  // lorry ever lands on the booked figure). closedAt records that the order is
  // done regardless of the balance - set automatically when the final lorry lands
  // within the Settings tolerance, or explicitly when the user short-closes an
  // order the buyer stopped lifting. tonnageKg is never rewritten, so the
  // shortfall stays readable as (tonnageKg - dispatchedKg).
  // Cleared by undo-dispatch / reopen, which put the balance back.
  closedAt    DateTime?
  closeReason String?

  // Each physical dispatch (lorry) is a SaleDispatch billed against this order.
  dispatches  SaleDispatch[]
  allocations SaleAllocation[]

  // --- Legacy columns (pre multi-dispatch). No longer written; kept so the
  // backfill migration can copy them into the first SaleDispatch row. ---
  receivedDate     DateTime?
  deliveredDate    DateTime?
  invoiceNumber    String?
  vehicleNumber    String?
  invoiceFileUrl   String?
  kataFileUrl      String?
  buyerKataKg      Int?
  shortageKg       Int?
  creditNoteAmount Decimal?  @db.Decimal(12, 2)
  buyerKataFileUrl String?
  invoiceSeq       Int?
  invoiceFy        String?
  invoiceDate      DateTime?

  createdAt DateTime @default(now())

  // Party ledger + sales lists group/filter orders by buyer (and broker); index
  // both FKs so those GROUP BY / WHERE scans stay index-driven as the table grows.
  @@index([buyerId])
  @@index([brokerId])
}

// A single physical dispatch (one lorry) shipped against a SaleOrder. Carries the
// actual kata weight, the sale's ledger posting, its own tax invoice, and the
// delivery + buyer-kata shortage settlement. An order may have many of these.
model SaleDispatch {
  id                String     @id @default(cuid())
  saleOrder         SaleOrder  @relation(fields: [saleOrderId], references: [id])
  saleOrderId       String
  dispatchDate      DateTime   @default(now())
  weightKg          Int // actual dispatched weight, per RVP kata (kg)
  internalWeightKg  Int? // weight before kata (without moisture gain)
  gstAmount         Decimal    @default(0) @db.Decimal(14, 2) // 5% IGST on weight × rate
  freightCharge     Decimal    @default(0) @db.Decimal(12, 2)
  // DISPATCHED → DELIVERED.
  status            SaleStatus @default(DISPATCHED)
  vehicleNumber     String?
  // Driver of the hired lorry - captured at dispatch (or filled from a confirmed
  // WhatsApp transport confirmation) and sent to the broker/buyer via WhatsApp.
  driverName        String?
  driverPhone       String?
  kataFileUrl       String?
  transportProvider String? // 'SURYA' | 'KNM' | 'OTHER'
  customRetention   Decimal?   @db.Decimal(12, 2) // user-entered retention for 'OTHER'

  // XS Pappu (excess out). The 60% out-turn is a planning assumption, not a
  // measurement - when the mill actually yields more, that surplus pappu is
  // physically real but invisible to the stock engine. Declaring part of a
  // shipment as excess-out asserts it was served from that yield surplus, so
  // that tonnage:
  //   - draws NO black seed (the seed cost was already fully recovered over the
  //     assumed 60%, so the surplus carries zero marginal cost)
  //   - relieves NO silo inventory at dispatch, keeping the GL consistent with
  //     the zero seed cost the Pappu P&L reports
  //   - never enters the allocation backlog, so incoming seed at RVP is not
  //     consumed on its behalf
  //
  // A QUANTITY, not a flag: one lorry can be part-backed and part-surplus (30 t
  // out against 20 t of seed = 10 t excess). Treating it as all-or-nothing would
  // stop the backed 20 t drawing seed and silently overstate stock.
  // Both allocators subtract it from an order's demand; see `excessOutKgOf`.
  excessOutKg   Int     @default(0)
  excessOutNote String?

  // Byproduct dispatches only (Husk/Shell/Waste/Pre-cleaner Dust/Nalla*): flags
  // that this shipment's stock is being sold out of a transferred lot (see
  // StockTransfer/ShellTransfer/HuskTransfer) rather than straight off the
  // factory. Pure reporting tag - byproducts carry no valued inventory silo, so
  // it does not change COGS or any allocation.
  fromTransfer Boolean @default(false)

  // Delivery matching (buyer's kata slip captured at delivery).
  receivedDate               DateTime?
  deliveredDate              DateTime?
  buyerKataKg                Int?
  shortageKg                 Int?
  internalWeightProfitAmount Decimal?  @db.Decimal(12, 2)
  creditNoteAmount           Decimal?  @db.Decimal(12, 2)
  buyerKataFileUrl           String?
  tdsAmount                  Decimal?  @db.Decimal(12, 2)

  // Generated tax invoice. Number = prefix/seq/FY; seq resets each financial year.
  // invoiceSeries separates the numbering pools: "RVP" (registered tax invoices)
  // vs "URS" (Un-Registered Sales) - each series keeps its own running sequence.
  invoiceNumber String?
  invoiceSeq    Int?
  invoiceFy     String? // Indian financial year, e.g. "2026-27"
  invoiceSeries String    @default("RVP")
  invoiceDate   DateTime?

  // Surya Road Lines lorry receipt (goods consignment note). The GC number comes
  // off the transporter's physical book, so it is typed in rather than derived;
  // the rest lets the printed copy state the packing the way the book does.
  lrNumber   String?
  lrDate     DateTime?
  lrBags     Int?
  lrKgPerBag Int?

  // E-Invoice (IRN) details
  irn              String?
  irnAckNo         String?
  irnAckDate       DateTime?
  irnSignedQr      String?
  irnStatus        String? // 'GENERATED', 'CANCELLED'
  irnCancelledDate DateTime?

  // E-Way Bill details
  ewbNumber        String?
  ewbDate          DateTime?
  ewbValidUpto     DateTime?
  ewbStatus        String? // 'GENERATED', 'CANCELLED'
  ewbCancelledDate DateTime?
  // Approx transport distance (km). When 0 is submitted NIC auto-computes it from
  // the two PIN codes and returns the figure - that returned value is what gets
  // stored, so the printed bill never shows "0 km".
  ewbDistance      Int?
  // Part-A/Part-B details as actually submitted to NIC. Stored so the reprint
  // (which is rendered from a payload we rebuild, not fetched from NIC) shows the
  // same mode/vehicle type/document that the live bill carries.
  ewbTransMode     String? // '1'-Road, '2'-Rail, '3'-Air, '4'-Ship
  ewbVehicleType   String? // 'R'-Regular, 'O'-ODC
  ewbTransDocNo    String?
  ewbTransDocDate  DateTime?

  createdAt DateTime @default(now())

  receipts    Receipt[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]
  emailLogs   EmailLog[]

  @@unique([invoiceFy, invoiceSeq, invoiceSeries])
  @@index([saleOrderId])
}

model SaleAllocation {
  id              String           @id @default(cuid())
  saleOrder       SaleOrder        @relation(fields: [saleOrderId], references: [id])
  saleOrderId     String
  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String
  allocatedWeight Int
  status          AllocationStatus @default(SOFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([saleOrderId])
  @@index([purchaseOrderId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// Tally-style account-group hierarchy. `nature` fixes the debit/credit sign
// convention; `statement` decides whether the group lands on the Balance Sheet
// or the Profit & Loss.
enum GroupNature {
  ASSETS
  LIABILITIES
  INCOME
  EXPENSES
}

enum StatementType {
  BALANCE_SHEET
  PROFIT_LOSS
}

enum DiscountType {
  WEIGHT
  PRICE
  AMOUNT
}

enum PriceType {
  BASE
  DELIVERY
}

// Coarse intended destination chosen at PO time. RVP = expected to land directly
// at the process (sellable-as-pending in the Order Planner). STOCK = expected to
// go to a cold storage first, so it is withheld from the planner until it actually
// arrives at RVP (either stocked directly to RVP, or transferred in later).
enum PlannedLocation {
  RVP
  STOCK
}

// Which bunker the black seed is poured into at the process. Drives the
// bunker place (A or B).
enum BunkerPlace {
  A
  B
}

// Tally primary/sub groups, a self-referential tree (e.g. Current Assets →
// Stock-in-Hand). The nature + statement are inherited from the primary group.
model AccountGroup {
  id        String         @id @default(cuid())
  name      String         @unique
  parentId  String?
  parent    AccountGroup?  @relation("GroupTree", fields: [parentId], references: [id])
  children  AccountGroup[] @relation("GroupTree")
  nature    GroupNature
  statement StatementType
  sortOrder Int            @default(0)
  accounts  Account[]
}

model Account {
  id    String        @id @default(cuid())
  code  String        @unique
  name  String
  type  AccountType
  lines JournalLine[]

  // Tally classification + opening balance for Balance Sheet / P&L reporting.
  groupId        String?
  group          AccountGroup? @relation(fields: [groupId], references: [id])
  // Signed opening balance brought forward: +Dr (assets/expenses) / -Cr (liabilities/income).
  openingBalance Decimal       @default(0) @db.Decimal(14, 2)
  // Decommissioned heads kept for historical lines but hidden from the live chart.
  isDeprecated   Boolean       @default(false)
  sortOrder      Int           @default(0)
}

model JournalEntry {
  id          String        @id @default(cuid())
  date        DateTime
  reference   String?
  description String
  createdAt   DateTime      @default(now())
  lines       JournalLine[]
  payment     Payment?
  receipt     Receipt?
  setOff      PartySetOff?
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  journalEntryId String
  account        Account      @relation(fields: [accountId], references: [id])
  accountId      String
  debit          Decimal      @db.Decimal(12, 2)
  credit         Decimal      @db.Decimal(12, 2)
  costCenter     String?

  @@index([accountId])
  @@index([journalEntryId])
}

// Editable per-destination outward freight rates (₹/tonne), managed in Settings.
model FreightRate {
  id           String   @id @default(cuid())
  destination  String   @unique
  ratePerTonne Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt    DateTime @updatedAt
}

// Editable per-operation hamali (labour) rates (₹/tonne), managed in Settings.
// One row per operation key (BLACK_SEED_UNLOAD, PAPPU_LOADING, TRANSFER_FROM_STORAGE,
// HUSK_LOADING, TPS_LOADING, SHELL_TRANSFER). These drive the live costing - each
// controller fetches its headline rate and passes it into the calc functions.
model HamaliRate {
  id             String   @id @default(cuid())
  key            String   @unique
  label          String
  ratePerTonne   Decimal  @default(0) @db.Decimal(8, 2) // Total ₹/tonne charge
  lorryPerTonne  Decimal  @default(0) @db.Decimal(8, 2) // collected from the driver (off freight)
  marginPerTonne Decimal  @default(0) @db.Decimal(8, 2) // company P/L benefit (collect more than we pay the crew)
  isCustom       Boolean  @default(false) // user-added cost (vs the fixed operations); charged on every Pappu dispatch
  sortOrder      Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// Manually-entered hamali costs that can't be derived from purchases or sales.
// Two kinds:
//   Per-bag charges (amount = bags × ratePerBag):
//     - BAG_CUTTING_NORMAL    - bag cutting at Place A (≈₹3/bag)
//     - BAG_CUTTING_DISTANCE  - bag cutting at Place B (≈₹6/bag)
//     - PAPPU_NET             - pappu netting/bagging (≈₹6/bag)
//   Flat amounts (amount entered directly, bags/ratePerBag null):
//     - DIESEL                - diesel/fuel cost borne for the crew
//     - TARBAL_FEE            - tarpaulin (tarbal) charge for sheeting a lorry
//     - MISC                  - any other charge given to the hamali crew
//     - PAID                  - cash actually disbursed to the crew (settles the payable)
// Charge entries post Dr Factory Labor 50020 / Cr Hamali payable 20200; PAID
// posts Dr Hamali payable 20200 / Cr Cash-in-Hand 10410.
enum ManualHamaliType {
  BAG_CUTTING_NORMAL
  BAG_CUTTING_DISTANCE
  PAPPU_NET
  TPS_BROKENS_PACKING
  TAMARIND_BYPRODUCTS_PACKING
  DIESEL
  TARBAL_FEE
  MISC
  PAID
}

model ManualHamaliCost {
  id         String           @id @default(cuid())
  date       DateTime
  type       ManualHamaliType
  bags       Int?
  ratePerBag Decimal?         @db.Decimal(8, 2)
  amount     Decimal          @db.Decimal(12, 2) // per-bag: bags × ratePerBag; flat: entered directly
  note       String?
  createdBy  String?
  createdAt  DateTime         @default(now())
}

// A periodic reconciliation checkpoint on the Hamali Report: crew dues have been
// cross-verified with the hamali crew through `asOfDate` (inclusive). Verify-only
// marker with no GL posting - the actual cash settlement is recorded separately
// as a PAID ManualHamaliCost. The Hamali view locks rows on/before the latest
// checkpoint and shows the period since as the current, still-to-verify window.
model HamaliVerification {
  id          String    @id @default(cuid())
  asOfDate    DateTime // verified through this date, inclusive
  // Start of the squared-off window (snapshot). Null means "from the very start"
  // (the first-ever checkpoint). Stored alongside crewTotal so the Payables tab
  // shows a stable period even after earlier checkpoints are undone.
  periodStart DateTime?
  crewTotal   Decimal   @db.Decimal(12, 2) // snapshot of crew dues verified in this period
  note        String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  // Crew-settlement payments recorded against this squared-off period.
  payments    Payment[]
}

// Single-row seller profile printed on generated tax invoices. Edited in Settings.
model CompanyProfile {
  id                             String  @id @default("default")
  name                           String  @default("RVP INDUSTRIES")
  address                        String? // multi-line seller address
  gstin                          String?
  stateName                      String?
  stateCode                      String? // GST state code, e.g. "37"
  pincode                        String?
  contact                        String?
  // Bank details printed in the invoice footer.
  bankAccountName                String?
  bankName                       String?
  bankAccountNumber              String?
  bankBranchIfsc                 String?
  // --- E-Way Bill / e-invoice "Dispatch From" block --------------------------
  // The government print has a DISPATCH-FROM address and a *place* (town) that
  // are distinct from the registered address above: the place is what shows in
  // "Dispatch From" and in the vehicle-details "From" column, and NIC measures
  // the auto-calculated distance from dispatchFromPincode. All optional - each
  // one falls back to the registered address/pincode when left blank.
  dispatchFromPlace              String? // town, e.g. "Punganur"
  dispatchFromAddress1           String?
  dispatchFromAddress2           String?
  dispatchFromPincode            String?
  // Invoice number = invoicePrefix/seq/FY (e.g. RVP/01/2026-27).
  invoicePrefix                  String  @default("RVP")
  // JSON print-layout config (paper size, margins, font, column widths).
  invoiceLayout                  String?
  // Comma or newline separated list of company vehicles exempt from kata & hamali
  companyVehicles                String?
  // ₹ held back from each sale lorry freight until delivery, then paid to Surya
  // Roadlines once the kata slip is received (configurable; default ₹3000).
  freightRetentionPerTrip        Decimal @default(3000) @db.Decimal(12, 2)
  // Standard annual bank-loan interest rate (%) used to capitalise the stock's
  // carrying cost on storage→process transfers. Editable in the Loans section.
  loanInterestRatePct            Decimal @default(0) @db.Decimal(6, 3)
  // Buffer percentage (e.g. 80) of expected yield allowed for soft allocation.
  bufferStockPct                 Decimal @default(80) @db.Decimal(5, 2)
  // --- Sale-order close tolerance -------------------------------------------
  // How far UNDER the booked tonnage a final lorry may land and still close the
  // order (% of the ordered weight). A lorry never weighs exactly what was
  // booked, so without this every order ends life stuck on PARTIAL with a few
  // hundred kg of phantom balance. Pappu is bagged and lands close, so it gets
  // the tight figure; husk and the other loose byproducts are loaded by volume
  // and need the wider one. Beyond the tolerance the order stays open until
  // someone short-closes it deliberately.
  saleCloseTolerancePct          Decimal @default(0.5) @db.Decimal(5, 2)
  saleCloseToleranceByproductPct Decimal @default(2) @db.Decimal(5, 2)
  // --- Purchase-order arrival reminder --------------------------------------
  // How many days a PO may sit PENDING (ordered, lorry not stocked in) before
  // the login popup starts nagging about it. 0 turns the popup off entirely.
  poReminderDays                 Int     @default(3)
  // Owner/admin mobile that receives internal WhatsApp alerts (weekly summary,
  // daily dues digest, deferred-dispatch reminders). Falls back to
  // WHATSAPP_TEST_NUMBER when blank. Not printed on invoices.
  ownerWhatsappNumber            String?
  // Internal-alert distribution list - up to 3 members (name + number), stored as
  // a JSON string [{ "name": "...", "phone": "..." }]. These members receive the
  // dispatch reminders, weekly summary and daily dues digest. Falls back to
  // ownerWhatsappNumber, then WHATSAPP_TEST_NUMBER, when empty.
  alertRecipients                String?
  // WhatsApp test-mode toggle (UI-controlled, no redeploy needed). When ON,
  // every outbound WhatsApp is rerouted to whatsappTestNumber instead of the
  // real party. Defaults ON as a safety net. Overrides the WHATSAPP_TEST_MODE env.
  whatsappTestMode               Boolean @default(true)
  // Where test-mode messages land. Falls back to WHATSAPP_TEST_NUMBER env, then
  // ownerWhatsappNumber, when blank.
  whatsappTestNumber             String?

  // --- Owner daily WhatsApp digests (Settings -> WhatsApp) --------------------
  // Each owner-facing scheduled message can be switched off independently -
  // the cron still fires on schedule, the job just no-ops and logs a
  // "disabled in Settings" result instead of sending. See OWNER_DIGEST_JOBS in
  // server/src/jobs/whatsappJobs.ts, which maps each of these to its job key.
  ownerDuesDigestEnabled       Boolean @default(true) // rvp_owner_dues, 09:00 IST daily
  ownerDueTodayDigestEnabled   Boolean @default(true) // due_today, 06:00 IST daily
  ownerBusinessSnapshotEnabled Boolean @default(true) // rvpdaily, 06:00 IST daily
  ownerWeeklySummaryEnabled    Boolean @default(true) // rvp_owner_weekly, Monday 08:00 IST
  ownerDispatchReminderEnabled Boolean @default(true) // rvp_owner_dispatch, 09:00 IST daily (as needed)

  // Each digest's schedule, as a 5-field cron expression ("MIN HOUR * * DOW"),
  // editable in Settings -> WhatsApp. Defaults match the previously-hardcoded
  // schedule. Applied live by rescheduleOwnerJob() in whatsappJobs.ts - no
  // redeploy needed when an admin changes a time/day in Settings.
  ownerDuesDigestCron       String @default("0 9 * * *")
  ownerDueTodayDigestCron   String @default("0 6 * * *")
  ownerBusinessSnapshotCron String @default("0 6 * * *")
  ownerWeeklySummaryCron    String @default("0 8 * * 1")
  ownerDispatchReminderCron String @default("0 9 * * *")

  // TaxPro GSP configuration
  taxproGspId     String?
  taxproGspSecret String?
  taxproGstUser   String?
  taxproGstPass   String?
  taxproSandbox   Boolean @default(true)
  // Signature & Company Stamp dimensions (px)
  signatureHeight Int?    @default(55)
  stampSize       Int?    @default(95)

  updatedAt DateTime @updatedAt
}

// User-defined per-kg production cost components (electricity, labour, etc.).
// Their sum is the production cost per kg added on top of the black-seed cost
// for pappu (drives the displayed cost, the 3% margin check, and COGS).
// Per-product HSN/SAC code and invoice description, managed in Settings.
model ProductTaxInfo {
  id          String      @id @default(cuid())
  product     SaleProduct @unique
  hsn         String? // primary HSN/SAC (the GST-taxable code)
  hsnExempt   String? // alternate HSN for the GST-exempt (without-GST) variant, e.g. husk
  description String?
  gstRate     Decimal     @default(5) @db.Decimal(5, 2) // GST % for this commodity (e.g. 5, 12, 18)
  updatedAt   DateTime    @updatedAt
}

model SiloInventory {
  id         String   @id @default(cuid())
  itemType   String // "BLACK_SEED" | "WHITE_PAPPU" | "HUSK" | "WASTE"
  location   String // e.g. "RVP", "PGR COLD", "Murugan", "KNM Multi", "Finished Silo"
  weightKg   Int      @default(0)
  totalValue Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt
}

// Movement of black seed from a storage location (Rampalli/Murugan/Multi) to the
// process. Each transfer incurs two hamali legs (storage loading + process
// unloading), and transfer transport at the destination bunker -
// all 100% company-borne and capitalised into the seed's value at the process.
model StockTransfer {
  id              String       @id @default(cuid())
  fromLocation    String
  toLocation      String       @default("RVP")
  weightKg        Int
  lorryNumber     String?
  transportCharge Decimal      @default(0) @db.Decimal(12, 2)
  loadingHamali   Decimal      @default(0) @db.Decimal(12, 2) // storage-unload leg - no longer charged, always 0
  unloadingHamali Decimal      @default(0) @db.Decimal(12, 2) // load + unload combined
  bunkerPlace     BunkerPlace?

  hamaliMargin    Decimal  @default(0) @db.Decimal(12, 2) // company profit - no longer applicable, always 0
  // Bank-loan carrying interest capitalised into the seed at the process:
  // seedCostMoved × rate% × interestDays/365, where interestDays runs from the
  // earliest open loan's drawdown date to the transfer date.
  interestCharge  Decimal  @default(0) @db.Decimal(12, 2)
  interestDays    Int      @default(0)
  interestRatePct Decimal  @default(0) @db.Decimal(6, 3)
  seedCostMoved   Decimal  @default(0) @db.Decimal(12, 2) // seed value drawn from source, by price band (landed ex-GST), not MAP
  movedValue      Decimal  @default(0) @db.Decimal(12, 2) // seedCostMoved + capitalised transfer costs (hamali + transport)
  transferDate    DateTime
  createdAt       DateTime @default(now())
}

enum LoanStatus {
  OPEN
  CLOSED
}

// A single bank-loan drawdown (~₹15 lakh) taken against the stored stock, from
// one bank at a single standard rate. Interest accrues on the outstanding
// balance from drawdownDate until repaid; the carrying cost is capitalised into
// black seed when it moves storage→process (StockTransfer.interestCharge).
model BankLoan {
  id              String          @id @default(cuid())
  name            String? // loan name
  personName      String? // person on whose name loan is taken
  loanRef         String? // bank loan/account reference
  bankName        String?
  location        String?
  principal       Decimal         @db.Decimal(14, 2)
  drawdownDate    DateTime
  interestRatePct Decimal         @db.Decimal(6, 3) // snapshot of the rate at drawdown
  status          LoanStatus      @default(OPEN)
  closedDate      DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  repayments      LoanRepayment[]
}

model LoanRepayment {
  id        String   @id @default(cuid())
  loan      BankLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId    String
  amount    Decimal  @db.Decimal(14, 2) // principal portion - reduces the loan's outstanding
  interest  Decimal  @default(0) @db.Decimal(14, 2) // interest portion - settles the 20280 accrual (Dr 20280 / Cr Bank)
  date      DateTime
  reference String?
  createdAt DateTime @default(now())
}

enum PrivateLoanStatus {
  OPEN
  CLOSED
}

enum InterestPeriod {
  ANNUAL
  MONTHLY
}

// A loan WE give to someone else - the mirror of BankLoan (where we borrow).
// Principal disbursed is an asset (12025 Loans & Advances Given), not a
// liability. Interest is simple, accrues on the outstanding balance from
// startDate, and is booked as real P&L income (40130) only when actually
// collected on repayment - unlike BankLoan's capitalised-accrual interest.
model PrivateLoan {
  id              String                 @id @default(cuid())
  borrowerName    String
  phone           String?
  phone2          String?
  principal       Decimal                @db.Decimal(14, 2)
  startDate       DateTime
  // ALWAYS annual - the interest engine (loanInterest, days/365) assumes it.
  // interestPeriod is display-only: which unit the user entered/reads the
  // rate in, converted at the UI boundary (client) before this is written.
  interestRatePct Decimal                @db.Decimal(6, 3)
  interestPeriod  InterestPeriod         @default(ANNUAL)
  status          PrivateLoanStatus      @default(OPEN)
  closedDate      DateTime?
  notes           String?
  // Language the WhatsApp statement is sent in - falls back to English when
  // that language's copy isn't approved yet, same as Party.waLanguage.
  waLanguage      WaLanguage             @default(EN)
  createdAt       DateTime               @default(now())
  repayments      PrivateLoanRepayment[]
}

model PrivateLoanRepayment {
  id        String      @id @default(cuid())
  loan      PrivateLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId    String
  amount    Decimal     @db.Decimal(14, 2) // principal portion - reduces the loan's outstanding
  interest  Decimal     @default(0) @db.Decimal(14, 2) // interest portion - booked to Interest Income (40130)
  date      DateTime
  reference String?
  createdAt DateTime    @default(now())
}

// Movement of tamarind shell (a production byproduct) from the factory/process
// to the Rampalli storage, where it is later sold. Each transfer bears packing +
// loading + unloading hamali (₹333/tonne) and a fixed ₹500 transport - both
// capitalised into the shell's value at Rampalli.
model ShellTransfer {
  id              String   @id @default(cuid())
  fromLocation    String   @default("RVP")
  toLocation      String   @default("PGR COLD")
  weightKg        Int
  lorryNumber     String?
  hamaliCharge    Decimal  @default(0) @db.Decimal(12, 2) // ₹333/t packing+loading+unloading
  transportCharge Decimal  @default(0) @db.Decimal(12, 2) // fixed ₹500
  totalCost       Decimal  @default(0) @db.Decimal(12, 2) // hamali + transport, capitalised at Rampalli
  transferDate    DateTime
  createdAt       DateTime @default(now())
}

// A transfer of husk (a milling byproduct) from the factory to one of our storage
// locations (PGR COLD / Murugan / KNM Multi). Like ShellTransfer this is only a
// physical-movement + cost record; the ₹333/t hamali and fixed ₹500 transport are
// expensed (see LedgerService.postHuskTransfer). Kept as its own model so husk
// transfers stay separate from the shell/dust transfer list.
model HuskTransfer {
  id              String   @id @default(cuid())
  fromLocation    String   @default("RVP")
  toLocation      String // PGR COLD | Murugan | KNM Multi
  weightKg        Int
  lorryNumber     String?
  hamaliCharge    Decimal  @default(0) @db.Decimal(12, 2) // ₹333/t packing+loading+unloading
  transportCharge Decimal  @default(0) @db.Decimal(12, 2) // fixed ₹500
  totalCost       Decimal  @default(0) @db.Decimal(12, 2) // hamali + transport
  transferDate    DateTime
  createdAt       DateTime @default(now())
}

// A purchase of pre-cleaner dust bought IN from an outside party (distinct from a
// ShellTransfer, which only moves our own byproduct to storage). It raises a
// supplier payable (Cr Accounts Payable) against a direct-expense cost
// (Dr Pre Cleaner Dust Purchases) - see LedgerService.postDustPurchase.
model DustPurchase {
  id            String   @id @default(cuid())
  party         Party    @relation(fields: [partyId], references: [id])
  partyId       String
  purchaseDate  DateTime
  weightKg      Int
  pricePerKg    Decimal  @db.Decimal(12, 2) // ₹ per kg
  amount        Decimal  @db.Decimal(14, 2) // pricePerKg × weightKg (payable to the party)
  lorryNumber   String?
  invoiceNumber String?
  createdAt     DateTime @default(now())

  @@index([partyId])
}

model Payment {
  id                   String              @id @default(cuid())
  date                 DateTime
  amount               Decimal             @db.Decimal(12, 2)
  type                 String // 'SUPPLIER' | 'TRANSPORTER' | 'BROKER' | 'OTHER' | expense heads (DIESEL, HAMALI, ELECTRICITY, …) | 'DRAWINGS'
  partyId              String?
  party                Party?              @relation(fields: [partyId], references: [id])
  purchaseId           String?
  purchase             Purchase?           @relation(fields: [purchaseId], references: [id])
  brokerId             String?
  broker               Broker?             @relation(fields: [brokerId], references: [id])
  lorryNumber          String?
  payee                String? // free-text recipient for expense/drawings payments (e.g. "Shabri Reddy")
  reference            String?
  description          String?
  // Links a HAMALI crew-settlement payment to the squared-off period it settles,
  // so the Payables tab can derive Paid / Partial / Unpaid status.
  hamaliVerificationId String?
  hamaliVerification   HamaliVerification? @relation(fields: [hamaliVerificationId], references: [id])
  // Uploaded proof-of-payment screenshot (Supabase Storage URL) - attached to the
  // WhatsApp payment notification sent to the party.
  screenshotUrl        String?
  // Set when this row is the payment-side leg of a party set-off rather than a
  // real payment. NO cash left the bank: the leg exists so Purchase Dues clears
  // the bill, and the matching Receipt leg clears the sale invoice. See
  // PartySetOff.
  setOffId             String?
  setOff               PartySetOff?        @relation(fields: [setOffId], references: [id], onDelete: Cascade)
  journalEntryId       String?             @unique
  journalEntry         JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  createdAt            DateTime            @default(now())

  @@index([partyId])
  @@index([purchaseId])
  @@index([brokerId])
  @@index([hamaliVerificationId])
  @@index([journalEntryId])
  @@index([setOffId])
}

model Receipt {
  id             String        @id @default(cuid())
  date           DateTime
  amount         Decimal       @db.Decimal(12, 2)
  tdsAmount      Decimal?      @db.Decimal(12, 2) // TDS deducted by buyer (0.1% of sale value)
  shortageAmount Decimal?      @db.Decimal(12, 2) // Kata / weight-shortage deduction
  type           String // 'BUYER' | 'OTHER' | income heads (GUNNY_BAGS_SALE, SCRAP_SALE, HAMALI_INCOME, INTEREST_INCOME)
  partyId        String?
  party          Party?        @relation(fields: [partyId], references: [id])
  saleDispatchId String?
  saleDispatch   SaleDispatch? @relation(fields: [saleDispatchId], references: [id])
  payer          String? // free-text payer for direct-income receipts (e.g. "gunny bag buyer")
  reference      String?
  description    String?
  // Receipt-side leg of a party set-off - no money was collected. See PartySetOff.
  setOffId       String?
  setOff         PartySetOff?  @relation(fields: [setOffId], references: [id], onDelete: Cascade)
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([partyId])
  @@index([saleDispatchId])
  @@index([journalEntryId])
  @@index([setOffId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Party set-off (contra / knock-off).
//
// A party we both BUY from and SELL to carries a payable and a receivable at the
// same time, and the two are routinely squared against each other instead of two
// bank transfers crossing. Recording that as a plain "payment made" posts only
// ONE leg: Purchase Dues goes quiet, but the sale invoice stays open forever and
// the party ledger gains a receivable that will never be collected (plus a bank
// credit for cash that never moved).
//
// A set-off is therefore always TWO-LEGGED and cash-free:
//   • one Payment  leg per purchase bill    (setOffId set) → clears Purchase Dues
//   • one Receipt  leg per sale invoice     (setOffId set) → clears Sale Dues
//   • one journal entry: Dr 20100 Accounts Payable / Cr 10100 Accounts Receivable
//     - NO 10400 Bank/Cash line, because no money moved.
// The legs are equal and opposite, so the party ledger's running balance is
// unchanged - which is correct: netting two balances does not alter the net
// position, it only settles the documents behind it.
// ─────────────────────────────────────────────────────────────────────────────
model PartySetOff {
  id             String        @id @default(cuid())
  date           DateTime
  partyId        String
  party          Party         @relation(fields: [partyId], references: [id])
  // Total knocked off: equals Σ payment legs and Σ receipt legs (both sides must
  // match, enforced on create).
  amount         Decimal       @db.Decimal(12, 2)
  note           String?
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  payments       Payment[]
  receipts       Receipt[]
  createdAt      DateTime      @default(now())

  @@index([partyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Standalone byproduct-pool expense/record reports. These are NOT posted to the
// accounting ledger; they feed only the dashboard Husk (byproduct) P&L pool, each
// netting against the pooled husk/T-waste/TPS/byproduct revenue.
// ─────────────────────────────────────────────────────────────────────────────

enum GunnyBagDirection {
  PURCHASE
  SALE
}

enum GunnyBagEntryType {
  PURCHASE // Bags bought (debit, husk-pool cost)
  SALE // Bags sold (credit, gunny-sales income)
  PAYMENT // Cash paid (separate payment line, reduces payable)
}

// Gunny (bardana) bags bought or sold - the "Feroz Ledger". PURCHASE is a husk-pool
// cost; SALE is booked separately as husk-pool income (Gunny Sales), not netted
// against the purchase cost (see computeHuskPool / getProfitLoss income section).
// PAYMENT tracks cash paid out to Feroz (reduces the payable balance).
model GunnyBagEntry {
  id        String             @id @default(cuid())
  date      DateTime
  type      GunnyBagEntryType  @default(PURCHASE)
  // Legacy fields (kept for backward compat during migration)
  direction GunnyBagDirection?
  amount    Decimal?           @db.Decimal(12, 2)
  // New fields (ledger-style: separate debit/credit columns + payment tracking)
  quantity  Int? // number of bags (null for PAYMENT entries)
  debit     Decimal            @default(0) @db.Decimal(12, 2) // PURCHASE amount or 0
  credit    Decimal            @default(0) @db.Decimal(12, 2) // SALE amount or 0
  payment   Decimal            @default(0) @db.Decimal(12, 2) // cash paid (PURCHASE auto-fills this, PAYMENT sets it)
  note      String?
  createdAt DateTime           @default(now())
}

// Standalone Gunny Bag Sales recorded in the Income tab (separate from Feroz Ledger).
// Posts a linked Receipt (type GUNNY_BAGS_SALE) to the accounting ledger.
model GunnySaleEntry {
  id        String   @id @default(cuid())
  date      DateTime
  bags      Int
  price     Decimal  @db.Decimal(12, 2)
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())
}

// Free-form "Other Income" entries (husk-pool Income tab) - anything that doesn't
// fit Kata Income, Hamali Company Profit or Gunny Sales. Posts a linked Receipt
// (type OTHER_INCOME) the same way the expense detail pages post linked Payments.
model OtherIncomeEntry {
  id        String   @id @default(cuid())
  date      DateTime
  label     String
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())
}

// Monthly electricity bill. `amount` (total bill) is the husk-pool expense; units
// & month are captured for reference.
model ElectricityBill {
  id        String   @id @default(cuid())
  date      DateTime
  month     String // billed month, e.g. "2026-07"
  units     Int      @default(0) // units consumed
  amount    Decimal  @db.Decimal(12, 2) // total bill ₹ (the expense)
  note      String?
  createdAt DateTime @default(now())
}

// Factory maintenance expense (QED AMC, repairs, etc.). Deducted from the pool.
model MaintenanceExpense {
  id          String   @id @default(cuid())
  date        DateTime
  description String // "QED AMC", "Factory repair", ...
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime @default(now())
}

// Catch-all miscellaneous operating expense recorded on the Expenses → Misc tab
// (anything that doesn't fit the dedicated heads). Posts a linked Payment to its
// own P&L expense head and is deducted from the husk recovery pool.
model MiscExpense {
  id          String   @id @default(cuid())
  date        DateTime
  description String // free-text label of the expense
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime @default(now())
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

// Recurring software/service subscription fee shown on the Expenses → Subscription
// tab. Rows are normally created by the recurring generator (subscription.service)
// rather than by hand; `periodKey` is the period the charge belongs to and is null
// on a manually-added one-off. Posts a linked Payment like every other expense
// head and is deducted from the husk recovery pool.
model SubscriptionCharge {
  id        String           @id @default(cuid())
  date      DateTime // the day the fee is charged (1 July / the 24th)
  plan      SubscriptionPlan
  periodKey String? // "2026" (yearly) or "2026-08" (monthly); null = manual entry
  amount    Decimal          @db.Decimal(12, 2)
  dueDate   DateTime // date + the plan's payment window (28 days for monthly)
  auto      Boolean          @default(true) // false = added by hand
  note      String?
  createdAt DateTime         @default(now())

  // Belt-and-braces against a double trigger racing the generator's cursor.
  // Postgres allows many NULLs here, so manual entries are unconstrained.
  @@unique([plan, periodKey])
}

// Recurrence settings for one SubscriptionCharge plan - one row per plan, seeded
// on first read and edited from the Subscription tab.
//
// `generatedThrough` is the cursor: only periods falling AFTER it are created, and
// it advances as they are. Without it, deleting an auto-generated charge would let
// the next run resurrect it.
model SubscriptionPlanConfig {
  id               SubscriptionPlan @id
  enabled          Boolean          @default(true)
  amount           Decimal          @db.Decimal(12, 2)
  chargeDay        Int // day of the month the fee lands, clamped to the month's length
  chargeMonth      Int? // yearly only: 1-based month, e.g. 7 = July
  dueDays          Int              @default(0) // payment window in days
  startDate        DateTime // nothing is generated before this
  generatedThrough DateTime? // charge date of the last period generated
  updatedAt        DateTime         @updatedAt
}

enum DrawingOwner {
  SHABRI
  REDDY
}

enum InterestType {
  CC
  TERM_LOAN
}

// Bank loan interest (cash-credit / term-loan) charged by the bank. Recorded from
// the Reports → Interest page and deducted from the husk pool as an operating cost.
model InterestCharge {
  id        String       @id @default(cuid())
  date      DateTime
  type      InterestType
  amount    Decimal      @db.Decimal(12, 2)
  note      String?
  createdAt DateTime     @default(now())
}

// Term-loan principal repayments, tracked as a simple informational list under the
// Interest report's Term Loan tab. Deliberately NOT posted to the ledger - the GL
// loan principal lives in BankLoan/LoanRepayment; this is a lightweight running log.
model TermLoanPrincipal {
  id        String   @id @default(cuid())
  date      DateTime
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())
}

// Owner drawings (Shabri / Reddy). Deducted from the husk pool per owner request.
model Drawing {
  id        String       @id @default(cuid())
  date      DateTime
  owner     DrawingOwner
  amount    Decimal      @db.Decimal(12, 2)
  note      String?
  createdAt DateTime     @default(now())
